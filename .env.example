# ============================================
# VARIÁVEIS DE AMBIENTE — EXEMPLO
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA versione o arquivo .env com credenciais reais.
# ============================================

# Azure
AZURE_SUBSCRIPTION_ID=<sua-subscription-id>
AZURE_RESOURCE_GROUP=<seu-resource-group>
AZURE_LOCATION=eastus

# Aplicação
APP_PORT=8000
APP_ENV=development

# Application Insights (opcional)
APPINSIGHTS_INSTRUMENTATIONKEY=<sua-instrumentation-key>
